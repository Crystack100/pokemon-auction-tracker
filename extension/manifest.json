{
  "manifest_version": 3,
  "name": "Pokémon Auction Tracker",
  "version": "0.14.2",
  "description": "Tracks Pokémon auctions in Facebook groups and compares live bids with eBay sold prices.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.ebay.com.au/*",
    "https://www.ebay.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com.au/sch/*",
        "https://www.ebay.com/sch/*"
      ],
      "js": [
        "ebay.js",
        "ebay-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Pokémon Auction Tracker"
  }
}