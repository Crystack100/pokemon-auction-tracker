{
  "manifest_version": 3,
  "name": "Pokémon Auction Tracker",
  "version": "0.16.3",
  "description": "Tracks Pokémon auctions in Facebook groups and compares live bids with eBay sold prices.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.ebay.com.au/*",
    "https://www.ebay.com/*",
    "https://www.pricecharting.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com.au/sch/*",
        "https://www.ebay.com/sch/*"
      ],
      "js": [
        "ebay.js",
        "ebay-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pricecharting.com/*"
      ],
      "js": [
        "pc-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://crystack100.github.io/pokemon-auction-tracker/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Pokémon Auction Tracker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}